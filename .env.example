# Credenciales de Notion (requerido)
# NOTION_SECRET: token de la integración interna de Notion (empieza con "ntn_" o "secret_")
# NOTION_ID_PAGE: id de la página de Notion donde se reciben los envíos (la página madre)
NOTION_SECRET=
NOTION_ID_PAGE=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# ─── Correo de confirmación (opcional, Gmail API vía OAuth2) ───
# Si se dejan vacías, el sistema NO envía correos (todo lo demás funciona igual).
# El envío usa la Gmail API por HTTP (compatible con Cloudflare, no usa SMTP).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
MAIL_FROM_NAME=Universidad de Nariño
